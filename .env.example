# Gemini AI API (optional)
GEMINI_API_KEY=your_gemini_api_key

# Public app base URL (optional outside deployment)
APP_URL=http://localhost:3000

# PostgreSQL (use DATABASE_URL or the individual SQL_* values)
DATABASE_URL=postgres://postgres:your_postgres_password@localhost:5432/skillplay_db
SQL_HOST=localhost
SQL_PORT=5432
SQL_DB_NAME=skillplay_db
SQL_USER=postgres
SQL_PASSWORD=your_postgres_password
SQL_SSL=false

# Admin dashboard credentials (required to access admin login)
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=use_a_long_random_password

# Telegram bot configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_telegram_admin_chat_id
TELEGRAM_BOT_USERNAME=YourBotUsername
VITE_TELEGRAM_BOT_USERNAME=YourBotUsername
TELEGRAM_MINI_APP_URL=https://your-domain.example/

# Platform-only rewards (not withdrawable cash)
COINS_PER_GAME_WIN=5
COINS_PER_REFERRAL_GAME=10


